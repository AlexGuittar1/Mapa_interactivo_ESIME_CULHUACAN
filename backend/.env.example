# ============================================
# ESIME Campus Map - Configuración de Entorno
# ============================================
# Copie este archivo como .env y ajuste los valores.

# Modo de ejecución: local | institutional
APP_ENV=local

# Clave secreta para sesiones (cambiar en producción)
# SECRET_KEY=una-clave-secreta-muy-larga-y-aleatoria

# ============================================
# MODO LOCAL (default)
# ============================================
# No requiere configuración adicional.
# Usa SQLite y autenticación por boleta.

# ============================================
# MODO INSTITUCIONAL
# Descomentar y configurar cuando la escuela
# integre sus propios sistemas.
# ============================================

# --- Base de Datos Institucional ---
# Opciones de conexión:
# SQL Server: mssql+pyodbc://user:pass@server/db?driver=ODBC+Driver+17+for+SQL+Server
# PostgreSQL: postgresql://user:pass@server:5432/db
# DATABASE_URL=sqlite:///campus.db
# DATA_PROVIDER=sqlserver

# --- Azure Active Directory ---
# Obtener de Azure Portal > App Registrations
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- API Institucional (alternativa) ---
# Si la escuela expone una API REST para consultar alumnos
# INSTITUTIONAL_API_URL=https://api.escuela.edu.mx/v1
# INSTITUTIONAL_API_KEY=xxxxxxxxxxxxxxxxxx
